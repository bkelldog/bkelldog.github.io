{% extends "layouts/notebook.njk" %}

{% block content %}
<article class="post">
	<header class="flex-column">
    	<h1>{{ title }}</h1>
    	<time datetime="{{ page.date | formatDate("YYYY-MM-DD") }}">{{ page.date | formatDate }}</time>
  	</header>
  	<hr class="hr-short short-margin">
  	<style>
  		ul li::before {
			content: '–';
			font-weight: 700;
			margin-right: 0.5em;
			margin-left: -1.25em;
		}

		header li::before {
			content: none;
		}
  	</style>
  	<div class="content">
		{{ content | safe }}
	</div>
</article>
{% include "components/footer.njk" %}
{% endblock %}